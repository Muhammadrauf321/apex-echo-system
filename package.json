{
  "name": "apex-echo-system",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Apex Education Forum Ecosystem: Website, Real-Time Messaging App, and Management System",
  "workspaces": [
    "apps/*",
    "shared"
  ],
  "scripts": {
    "dev:website": "npm --workspace=@apex/website run dev",
    "dev:messaging": "npm --workspace=@apex/messaging-app run dev",
    "dev:management": "npm --workspace=@apex/management-system run dev",
    "build": "npm run build --workspaces --if-present && node scripts/bundle-unified.js",
    "deploy:firebase": "firebase deploy"
  },
  "keywords": [
    "apex-education-forum",
    "education",
    "firebase",
    "messaging",
    "management-system",
    "lms"
  ],
  "author": "Muhammad Rauf",
  "license": "MIT",
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "canvas-confetti": "^1.9.4",
    "firebase": "^12.10.0",
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "vite": "^8.2.2"
  }
}
