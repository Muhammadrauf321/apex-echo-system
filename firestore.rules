rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: Allow reading and writing for authentication, registration and profile syncing
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Inquiries: Allow public submissions from website
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Public educational records: Synchronized between Management LMS & Public Website
    match /courses/{courseId} {
      allow read, write: if true;
    }
    match /batches/{batchId} {
      allow read, write: if true;
    }

    // Certificates: Allow public verification by ID
    match /certificates/{certId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Faculty, Students & Invitations: Real-time synchronization across portals & devices
    match /teachers/{teacherId} {
      allow read, write: if true;
    }
    match /students/{studentId} {
      allow read, write: if true;
    }
    match /invitations/{invitationId} {
      allow read, write: if true;
    }

    // Password resets & messaging channels
    match /password_resets/{resetId} {
      allow read, write: if true;
    }
    match /channels/{channelId} {
      allow read, write: if true;
      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    // Default rule for all other documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
