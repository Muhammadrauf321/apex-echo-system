rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: Allow reading and writing for authentication, registration and profile syncing
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }
    
    // Inquiries: Allow public submissions from website
    match /inquiries/{inquiryId} {
      allow read, write: if true;
    }

    // Public educational records: Allow public read, authenticated write
    match /courses/{courseId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /batches/{batchId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Certificates: Allow public verification by ID
    match /certificates/{certId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Default rule for all other documents
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
