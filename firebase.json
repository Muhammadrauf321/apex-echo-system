{
  "hosting": {
    "public": "dist-unified",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/connect/**",
        "destination": "/connect/index.html"
      },
      {
        "source": "/lms/**",
        "destination": "/lms/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
